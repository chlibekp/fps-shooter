; TacticalFPS Godot client. See Documentation/GODOT.md.
config_version=5

[application]
config/name="TacticalFPS"
config/description="Tactical multiplayer FPS client"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]
export/convert_text_resources_to_binary=true

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=0
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
global_illumination/sdfgi/probe_ray_count=2
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
